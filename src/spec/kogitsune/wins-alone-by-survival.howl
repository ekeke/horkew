rules:
  general.first-victim: none
---
# Day 1 投票で Dave (村) を処刑、 Day 2 で Carol (狼) を処刑 → 狼全滅。
# Alice (子狐) は生存しているため fox-win-counter trait により werehamster_won。

++Alice、Bob、Carol、Dave、Eve
!Alice=子狐
!Bob=村人
!Carol=人狼
!Dave=村人
!Eve=村人

# == engine: Night 0 ==
# peace (襲撃が attack-immune で無効)
# == end ==

Alice→Dave
Bob→Dave
Carol→Bob
Dave→Carol
Eve→Dave

# == engine: Day 1 ==
# vote tally: Dave 3 / Bob 1 / Carol 1 → execution=Dave
# == end ==
# == engine: Night 1 ==
# peace (襲撃が attack-immune で無効)
# == end ==

Day 2:

Alice→Carol
Bob→Carol
Eve→Carol
Carol→Bob

# == engine: Day 2 ==
# vote tally: Carol 3 / Bob 1 → execution=Carol
# == end ==
# == engine: Final ==
# result: werehamster_won
# survivors: Alice, Bob, Eve
# == end ==

# @expect-status Alice: alive
# @expect-result: werehamster_won
