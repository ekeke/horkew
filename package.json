{
  "name": "horkew",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    "./howl": "./src/howl/index.ts",
    "./types": "./src/types/index.ts",
    "./retar": "./src/retar/index.ts",
    "./retar/wasm-helpers": "./src/retar/wasm-helpers.ts",
    "./retar-rs/node": "./src/retar-rs/pkg/retar.js",
    "./retar-rs/web": "./src/retar-rs/pkg-web/retar.js",
    "./retar-rs/wasm-url": "./src/retar-rs/pkg/retar_bg.wasm",
    "./lykaon": "./src/lykaon/index.ts",
    "./lykaon/theme.css": "./src/lykaon/theme.css"
  },
  "scripts": {
    "build": "npm run build:lib && npm run build:demo",
    "build:lib": "tsc",
    "test": "node --experimental-strip-types --test --experimental-test-coverage",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/lykaon/tsconfig.json && tsc --noEmit -p src/lykaon/tsconfig.worker.json && tsc --noEmit -p demo/tsconfig.json",
    "build:wasm": "bash src/retar-rs/build.sh all",
    "build:wasm:node": "bash src/retar-rs/build.sh build",
    "build:wasm:web": "bash src/retar-rs/build.sh build-web",
    "build:wasm:dump": "bash src/retar-rs/build.sh build-dump",
    "test:rust": "bash src/retar-rs/build.sh test",
    "bench:retar": "node --experimental-strip-types src/retar/bench.ts",
    "bench:retar:wasm": "node --experimental-strip-types src/retar/bench-wasm.ts",
    "puzzle": "node --experimental-strip-types src/hati/puzzle-cli.ts",
    "lupa": "node --experimental-strip-types src/lupa/cli.ts",
    "verify:retar": "node --experimental-strip-types src/verify/retar-verify.ts",
    "verify:hati": "node --experimental-strip-types src/hati/verify.ts",
    "eval-summary": "node --experimental-strip-types src/howl/scripts/eval-summary.ts",
    "dev": "vite",
    "gen-role-docs": "node --experimental-strip-types scripts/gen-role-docs.ts demo/public/roles.html",
    "spec:annotate": "node --experimental-strip-types scripts/spec-annotate-cli.ts",
    "build:demo": "npm run gen-role-docs && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.14.0",
    "svelte": "^5.54.0",
    "ts-morph": "^28.0.0",
    "typescript": "~5.7.3",
    "vite": "^8.0.0"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.40.0",
    "js-yaml": "^4.1.0",
    "partykit": "^0.0.115",
    "partysocket": "^1.1.16"
  }
}
